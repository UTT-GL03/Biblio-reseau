{
  "documents": [
    {{#repeat min=20 max=30}}
    {
      "image": "{{random 'image1.png' 'image2.png' 'image3.png' 'image4.png'}}",
      "title": "{{lorem min=1 max=20}}",
      "creator": "{{firstName}} {{lastName}}",
      "langue":"{{random 'français' 'anglais' 'Espagnol' 'portugais' 'russe' 'grec' 'italien' 'queshua'}}",
      "type": "{{random 'livre' 'Presse' 'Musique' 'Film'}}",
      "disponibility":"{{random 'emprunté' 'disponible'}}",
      "issued": "{{date '1500-01-01' '2026-10-12' 'YYYY-MM-DD'}}",
      "tags": [{{#repeat min=1 max=5 comma=true}}"{{lorem min=1 max=2}}"{{/repeat}}],
      "content": "{{#repeat min=1 max=15 comma=false}}{{lorem min=5 max=120}}\n\n{{/repeat}}",
      "identifiant":"{{int 1000000000 9999999999}}", 
      "editeur":"{{firstName}} {{lastName}}"
    }
    {{/repeat}}
  ],
  "evenements": [
    {{#repeat min=20 max=30}}
    {
      "title": "{{lorem min=1 max=20}}",
      "creator": "{{firstName}} {{lastName}}",
      "issued": "{{date '2026-10-12' '2026-12-31' 'YYYY-MM-DD hh:mm'}}",
      "lieu": "{{random 'Troyes' 'Saint André les Vergers' 'Rosière-près-troyes' 'Saint Part en tertre' 'Saint sulpice' 'Sainte Savine' 'Saint Julien les Villas'}}",
      "description": "{{#repeat min=1 max=15 comma=false}}{{lorem min=5 max=120}}\n\n{{/repeat}}",
      "image": "{{random 'image1.png' 'image2.png' 'image3.png' 'image4.png'}}"
    }
    {{/repeat}}
  ]
}
